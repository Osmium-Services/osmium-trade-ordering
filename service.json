{
    "id": "osmium-trade-ordering",
    "name": "Trade Ordering",
    "version": "0.5.0",
    "description": "Trade pricing and ordering for trade customers: a discount and payment terms per customer, brands excluded from the discount, and trade orders. Builds on Trade Accounts and the shop.",
    "category": "business",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",
    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": [
            "osmium-trade-accounts",
            "osmium-shop"
        ]
    },
    "autoload": [
        "models"
    ],
    "migrations": "migrations/",
    "hooks": {
        "trade.customer.fields": [
            "Osmium\\Services\\TradeOrdering\\Models\\TradeOrderingHooks::fields"
        ],
        "trade.customer.fields.validate": [
            "Osmium\\Services\\TradeOrdering\\Models\\TradeOrderingHooks::validate"
        ],
        "trade.customer.fields.save": [
            "Osmium\\Services\\TradeOrdering\\Models\\TradeOrderingHooks::save"
        ],
        "dashboard.widgets": [
            "Osmium\\Services\\TradeOrdering\\Models\\TradeDashboard::widget"
        ]
    },
    "admin": {
        "menu": {
            "section": "Content",
            "items": [
                {
                    "id": "trade-orders",
                    "label": "Trade Orders",
                    "icon": "bx bx-package",
                    "placement": "top",
                    "route": "admin/trade/orders",
                    "activePattern": "admin/trade/orders*",
                    "role": null
                },
                {
                    "id": "trade-ordering-settings",
                    "label": "Trade Ordering",
                    "icon": "bx bx-purchase-tag",
                    "route": "admin/settings/trade-ordering",
                    "activePattern": "admin/settings/trade-ordering*",
                    "role": "admin"
                }
            ]
        },
        "routes": {
            "admin/settings/trade-ordering": {
                "controller": "controllers/TradeOrderingSettingsController.php",
                "class": "Osmium\\Services\\TradeOrdering\\Controllers\\TradeOrderingSettingsController",
                "method": "index",
                "title": "Trade Ordering Settings"
            },
            "admin/trade/orders": {
                "controller": "controllers/TradeOrdersController.php",
                "class": "Osmium\\Services\\TradeOrdering\\Controllers\\TradeOrdersController",
                "method": "index",
                "title": "Trade Orders"
            },
            "admin/trade/orders/action": {
                "controller": "controllers/TradeOrdersController.php",
                "class": "Osmium\\Services\\TradeOrdering\\Controllers\\TradeOrdersController",
                "method": "action"
            }
        }
    }
}
